DATABASE_URL=postgresql+psycopg://sekuro:sekuro@localhost:5432/sekuro
AUTH_ISSUER=https://your-clerk-domain.clerk.accounts.dev
AUTH_AUDIENCE=sekuro-api
# Optional: defaults to ${AUTH_ISSUER}/.well-known/jwks.json
AUTH_JWKS_URL=
AUTH_ALGORITHMS=RS256
AUTH_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Monitoring results older than this are removed when a new check is stored.
HISTORY_RETENTION_DAYS=90
# Scheduler worker settings. Run one or more workers separately from FastAPI.
SCHEDULER_POLL_SECONDS=5
SCHEDULER_MAX_CONCURRENCY=10
SCHEDULER_BATCH_SIZE=10
SCHEDULER_CLAIM_TTL_SECONDS=300
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_RETRY_BASE_SECONDS=1
SCHEDULER_RETRY_MAX_SECONDS=30
